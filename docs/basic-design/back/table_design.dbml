# テーブル設計（DBML形式）

Table users {
id bigint [primary key]
name varchar
email varchar [unique]
password varchar
created_at timestamp
}

Table projects {
id bigint [primary key]
name varchar
owner_id bigint [not null]
created_at timestamp
updated_at timestamp
}

Table tasks {
id bigint [primary key]
project_id bigint [not null]
title varchar [not null]
description text
status bigint [note: '1:TODO, 2:DOING, 3:DONE']
created_at timestamp
updated_at timestamp
}

Ref project_owner: projects.owner_id > users.id // many-to-one

Ref project_tasks: tasks.project_id > projects.id // many-to-one
